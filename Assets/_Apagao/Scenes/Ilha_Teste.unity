--- !u!114 &1963478662
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1963478661}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a62fa80a93b91f548f02e210312d47c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Apagao.Game.Campaign
  objectives:
  - text: "Chegue \xE0 bancada no come\xE7o da vila"
    kind: 0
    target: {fileID: 1163435034}
    radius: 3
    checkpoint: 0
    signal: 0.95
    onStart:
    - speaker: Lia
      text: "Caio? Caio, t\xE1 me ouvindo? Aqui \xE9 a Lia."
      duration: 3.5
    - speaker: Caio
      text: "T\xF4 ouvindo. A vila t\xE1 cheia dessas coisas."
      duration: 3.5
    - speaker: Lia
      text: Tem uma bancada logo na entrada. Junta o que achar antes de seguir.
      duration: 4
    onComplete:
    - speaker: Lia
      text: "Usa o que tiver. Elas n\xE3o descansam, e voc\xEA tamb\xE9m n\xE3o pode."
      duration: 4
  - text: "Derrube a antena da VIG\xCDLIA no fim da rua"
    kind: 2
    target: {fileID: 293078421}
    radius: 0
    checkpoint: 1
    signal: 0.7
    onStart:
    - speaker: Lia
      text: "Tem uma antena perto da igreja. \xC9 por ela que as m\xE1quinas conversam."
      duration: 4.5
    - speaker: Lia
      text: Derruba ela e elas ficam cegas umas das outras.
      duration: 4
    onComplete:
    - speaker: Caio
      text: "Antena no ch\xE3o."
      duration: 3.5
    - speaker: Lia
      text: "Ouvi o estalo daqui. Agora o r\xE1dio da esta\xE7\xE3o, atr\xE1s da igreja."
      duration: 4
  - text: "Chegue ao r\xE1dio da esta\xE7\xE3o, atr\xE1s da igreja"
    kind: 1
    target: {fileID: 625624374}
    radius: 0
    checkpoint: 1
    signal: 0.35
    onStart:
    - speaker: Lia
      text: "O sinal t\xE1 caindo, Caio. Chega no r\xE1dio e chama o continente. Eu n\xE3o vou conseguir te ouvir por muito tempo."
      duration: 5
    onComplete:
    - speaker: Caio
      text: "Continente, aqui \xE9 o Caio, da Ilha do Amparo. Algu\xE9m na escuta?"
      duration: 4
    - speaker: Lia?
      text: "Caio. Fica onde voc\xEA est\xE1. A gente t\xE1 indo te buscar."
      duration: 4.5
    - speaker: 
      text: "O sinal est\xE1 limpo demais. Aquela n\xE3o \xE9 a Lia."
      duration: 4.5
